{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-video-reconstruction:scene:1.0.0",
  "title": "Game Video Blockout Scene 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "scene_type", "created_at", "coordinate_system", "unit_scale", "objects", "cameras", "timeline", "relationships", "reconstruction_metadata"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scene_id": {"$ref": "#/$defs/id"},
    "scene_type": {"$ref": "#/$defs/estimate"},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinate_system": {"const": "blender_rh_z_up"},
    "unit_scale": {"const": 1.0, "description": "All lengths and positions are metres; rotations are quaternion xyzw."},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "cameras": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/camera"}},
    "timeline": {"$ref": "#/$defs/timeline"},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "reconstruction_metadata": {"type": "object", "additionalProperties": false,
      "required": ["status", "data_source", "geometry_contract_verified", "provider", "limitations"],
      "properties": {"status": {"enum": ["complete", "partial_geometry_unverified", "partial_observations"]}, "data_source": {"type": "string", "minLength": 1}, "geometry_contract_verified": {"type": "boolean"}, "provider": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string"}}, "input_manifest": {"type": ["string", "null"]}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "positive3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
    "quat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "provenance": {"enum": ["ground_truth", "predicted", "inferred", "unobserved"]},
    "confidence": {"type": "object", "additionalProperties": false, "required": ["score", "provenance", "method", "evidence"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}, "provenance": {"$ref": "#/$defs/provenance"}, "method": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}},
    "estimate": {"type": "object", "additionalProperties": false, "required": ["value", "confidence"], "properties": {"value": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "transform": {"type": "object", "additionalProperties": false, "required": ["position", "rotation", "scale"], "properties": {"position": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/quat"}, "scale": {"$ref": "#/$defs/positive3"}}, "description": "Object local to world, quaternion xyzw. Dimensions describe an unscaled primitive; scale is dimensionless. Parent is organizational, not a local-transform override."},
    "frame": {"type": "object", "additionalProperties": false, "required": ["frame_index", "timestamp_seconds", "original_tick", "camera_id", "source_observation_id"], "properties": {"frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "original_tick": {"type": "integer", "minimum": 0}, "camera_id": {"$ref": "#/$defs/id"}, "source_observation_id": {"$ref": "#/$defs/id"}}},
    "timeline": {"type": "object", "additionalProperties": false, "required": ["fps", "start_seconds", "end_seconds", "time_origin", "frames"], "properties": {"fps": {"type": "number", "exclusiveMinimum": 0}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "minimum": 0}, "time_origin": {"type": "string", "minLength": 1}, "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}}}},
    "mask": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "confidence"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"enum": ["instance", "polygon", "bbox_proxy"]}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["frame_index", "timestamp_seconds", "camera_id", "bbox_xyxy", "raster_size", "mask", "position", "dimensions", "geometry_confidence", "point_count"], "properties": {"frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "camera_id": {"$ref": "#/$defs/id"}, "bbox_xyxy": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}}, "raster_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "mask": {"$ref": "#/$defs/mask"}, "position": {"anyOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]}, "dimensions": {"anyOf": [{"$ref": "#/$defs/positive3"}, {"type": "null"}]}, "geometry_confidence": {"$ref": "#/$defs/confidence"}, "point_count": {"type": "integer", "minimum": 0}}},
    "motion_sample": {"type": "object", "additionalProperties": false, "required": ["frame_index", "timestamp_seconds", "transform", "confidence"], "properties": {"frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "transform": {"$ref": "#/$defs/transform"}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "geometry_source": {"type": "object", "additionalProperties": false, "required": ["kind", "point_cloud_path", "bounds_type", "confidence"], "properties": {"kind": {"enum": ["depth_mask", "point_cloud_mask", "unobserved"]}, "point_cloud_path": {"type": ["string", "null"]}, "bounds_type": {"enum": ["observed_surface_aabb", "unobserved"]}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "visibility": {"type": "object", "additionalProperties": false, "required": ["frame_index", "timestamp_seconds", "camera_id", "state"], "properties": {"frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "camera_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["visible", "not_detected"]}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["object_id", "category", "primitive_type", "transform", "dimensions", "parent_id", "is_static", "classification_confidence", "confidence", "geometry_source", "source_frames", "motion_track", "visibility", "observations", "tracking_confidence"], "properties": {"object_id": {"$ref": "#/$defs/id"}, "category": {"enum": ["person", "tree", "rock", "ground", "barrier"]}, "primitive_type": {"enum": ["box", "capsule", "cylinder", "plane"]}, "transform": {"anyOf": [{"$ref": "#/$defs/transform"}, {"type": "null"}]}, "dimensions": {"anyOf": [{"$ref": "#/$defs/positive3"}, {"type": "null"}]}, "parent_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "is_static": {"type": ["boolean", "null"]}, "classification_confidence": {"$ref": "#/$defs/confidence"}, "confidence": {"$ref": "#/$defs/confidence"}, "tracking_confidence": {"$ref": "#/$defs/confidence"}, "geometry_source": {"$ref": "#/$defs/geometry_source"}, "source_frames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "motion_track": {"type": "array", "items": {"$ref": "#/$defs/motion_sample"}}, "visibility": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visibility"}}, "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}}},
    "matrix4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}},
    "intrinsics": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "camera_sample": {"type": "object", "additionalProperties": false, "required": ["frame_index", "timestamp_seconds", "world_from_camera", "intrinsics", "confidence"], "properties": {"frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "world_from_camera": {"anyOf": [{"$ref": "#/$defs/matrix4"}, {"type": "null"}]}, "intrinsics": {"anyOf": [{"$ref": "#/$defs/intrinsics"}, {"type": "null"}]}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "camera": {"type": "object", "additionalProperties": false, "required": ["camera_id", "local_axes", "track", "raw_source"], "properties": {"camera_id": {"$ref": "#/$defs/id"}, "local_axes": {"const": "optical_x_right_y_down_z_forward"}, "track": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/camera_sample"}}, "raw_source": {"type": ["string", "null"]}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["subject_id", "predicate", "object_id", "frame_index", "timestamp_seconds", "confidence"], "properties": {"subject_id": {"$ref": "#/$defs/id"}, "object_id": {"$ref": "#/$defs/id"}, "predicate": {"enum": ["negative_x_of", "above", "near", "intersects", "supported_by"]}, "frame_index": {"type": "integer", "minimum": 0}, "timestamp_seconds": {"type": "number", "minimum": 0}, "confidence": {"$ref": "#/$defs/confidence"}}}
  }
}
